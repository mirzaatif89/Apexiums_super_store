# cPanel / CloudLinux Passenger configuration for the Node.js application.
# This sends requests to app.js instead of exposing this project directory.
PassengerAppRoot "/home/apexium2/elistin.com"
PassengerBaseURI "/"
PassengerNodejs "/home/apexium2/nodevenv/elistin.com/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js

# Never expose the repository directory if Passenger is unavailable.
Options -Indexes
